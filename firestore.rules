rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Connection testing doc
    match /test/connection {
      allow read, write: if true;
    }

    // User-isolated collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{settingId} {
        allow read, write: if isOwner(userId);
      }

      match /documents/{documentId} {
        allow read, write: if isOwner(userId) && isValidId(documentId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId) && isValidId(transactionId);
      }

      match /accounts/{accountId} {
        allow read, write: if isOwner(userId) && isValidId(accountId);
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId) && isValidId(budgetId);
      }

      match /assets/{assetId} {
        allow read, write: if isOwner(userId) && isValidId(assetId);
      }

      match /maintenanceRecords/{recordId} {
        allow read, write: if isOwner(userId) && isValidId(recordId);
      }

      match /pantryItems/{itemId} {
        allow read, write: if isOwner(userId) && isValidId(itemId);
      }

      match /shoppingLists/{listId} {
        allow read, write: if isOwner(userId) && isValidId(listId);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId) && isValidId(reminderId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId) && isValidId(notificationId);
      }

      match /aiInsights/{insightId} {
        allow read, write: if isOwner(userId) && isValidId(insightId);
      }

      match /automationEvents/{eventId} {
        allow read, write: if isOwner(userId) && isValidId(eventId);
      }
    }
  }
}
